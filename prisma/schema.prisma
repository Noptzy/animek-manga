generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm, pgcrypto] 
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  name          String?
  photoUrl      String?        @map("photo_url")
  roleId        Int            @default(1) @map("role")
  password      String?
  isActive      Boolean?       @default(true) @map("is_active")
  metadata      Json?          @default("{}")
  createdAt     DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  favorites     Favorite[]
  notifications Notification[]
  history       UserHistory[]
  role          Role           @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  users     User[]

  @@map("role")
}

model Manga {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  slug        String       @unique
  posterUrl   String?      @map("poster_url")
  status      String?
  author      String?
  illustrator String?
  altTitle    String?      @map("alt_title")
  synopsis    String?
  sourceUrl   String?      @map("source_url")
  scrapedAt   DateTime?    @map("scraped_at") @db.Timestamp(0)
  createdAt   DateTime?    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  chapters    Chapter[]
  favorites   Favorite[]
  history     UserHistory[]
  genres      MangaGenre[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, name: "manga_title_search_idx")
  @@index([altTitle(ops: raw("gin_trgm_ops"))], type: Gin, name: "manga_alttitle_search_idx")
  @@map("mangas")
}

model Genre {
  id     String       @id @default(uuid()) @db.Uuid
  name   String       @unique
  slug   String       @unique
  mangas MangaGenre[]

  @@map("genres")
}

model MangaGenre {
  mangaId String @map("manga_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  manga   Manga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@id([mangaId, genreId])
  @@map("manga_genres")
}

model Chapter {
  id           String    @id @default(uuid()) @db.Uuid
  mangaId      String?   @map("manga_id") @db.Uuid
  chapterIndex String    @map("chapter_index")
  title        String?
  url          String
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  manga        Manga?    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  history      UserHistory[]

  @@unique([mangaId, chapterIndex])
  @@map("chapters")
}

model Server {
  id        Int       @id @default(autoincrement())
  title     String    @unique @db.VarChar(50)
  baseUrl   String?   @map("base_url")
  isActive  Boolean?  @default(true) @map("is_active")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  animeSources   AnimeSource[]
  serverGenres   ServerGenre[]
  episodeStreams EpisodeStream[]

  @@map("servers")
}

model Anime {
  id            String    @id @default(uuid()) @db.Uuid
  title         String
  slug          String    @unique
  altTitle      String?   @map("alt_title")
  posterUrl     String?   @map("poster_url")
  synopsis      String?
  status        String?   @db.VarChar(50)
  season        String?   @db.VarChar(50)
  type          String?   @db.VarChar(50)
  duration      String?   @db.VarChar(50)
  rating        String?   @db.VarChar(50)
  score         Decimal?  @db.Decimal(3, 2)
  studio        String?   @db.VarChar(255)
  totalEpisodes Int?      @map("total_episodes")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  history           UserHistory[]
  animeSources      AnimeSource[]
  animeServerGenres AnimeServerGenre[]
  episodes          Episode[]
  favorites         Favorite[]

  @@index([updatedAt])
  @@index([createdAt])
  @@index([slug])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, name: "anime_title_search_idx")
  @@index([altTitle(ops: raw("gin_trgm_ops"))], type: Gin, name: "anime_alttitle_search_idx")
  @@map("anime")
}

model AnimeSource {
  id        String    @id @default(uuid()) @db.Uuid
  animeId   String    @map("anime_id") @db.Uuid
  serverId  Int       @map("server_id")
  sourceUrl String?   @map("source_url")
  scrapedAt DateTime? @default(now()) @map("scraped_at") @db.Timestamp(0)

  anime  Anime  @relation(fields: [animeId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([animeId])
  @@index([serverId, animeId])
  @@map("anime_sources")
}

model ServerGenre {
  id       String @id @default(uuid()) @db.Uuid
  serverId Int    @map("server_id")
  name     String @db.VarChar(100)
  slug     String @db.VarChar(100)

  server            Server             @relation(fields: [serverId], references: [id], onDelete: Cascade)
  animeServerGenres AnimeServerGenre[]

  @@unique([serverId, name], map: "unique_genre_per_server")
  @@unique([serverId, slug], map: "unique_slug_per_server")
  @@map("server_genres")
}

model AnimeServerGenre {
  animeId       String @map("anime_id") @db.Uuid
  serverGenreId String @map("server_genre_id") @db.Uuid

  anime       Anime       @relation(fields: [animeId], references: [id], onDelete: Cascade)
  serverGenre ServerGenre @relation(fields: [serverGenreId], references: [id], onDelete: Cascade)

  @@id([animeId, serverGenreId])
  @@map("anime_server_genres")
}

model Episode {
  id            String    @id @default(uuid()) @db.Uuid
  animeId       String    @map("anime_id") @db.Uuid
  episodeNumber Float     @map("episode_number")
  title         String?
  sourceUrl     String?   @map("source_url")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  anime     Anime             @relation(fields: [animeId], references: [id], onDelete: Cascade)
  streams   EpisodeStream[]
  downloads EpisodeDownload[]
  history   UserHistory[]

  @@unique([animeId, episodeNumber], map: "unique_episode_per_anime")
  @@index([animeId], map: "idx_episodes_anime")
  @@map("episodes")
}

model EpisodeStream {
  id        String    @id @default(uuid()) @db.Uuid
  episodeId String    @map("episode_id") @db.Uuid
  serverId  Int?      @map("server_id")
  host      String?
  quality   String?   @default("SD")
  url       String
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  server  Server? @relation(fields: [serverId], references: [id]) // OnDelete SetNull

  @@index([episodeId], map: "idx_streams_episode")
  @@map("episode_streams")
}

model EpisodeDownload {
  id        String    @id @default(uuid()) @db.Uuid
  episodeId String    @map("episode_id") @db.Uuid
  format    String
  resolutions   String
  host      String
  url       String
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId], map: "idx_downloads_episode")
  @@map("episode_downloads")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  mangaId   String?  @map("manga_id") @db.Uuid
  animeId   String?  @map("anime_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  anime     Anime?   @relation(fields: [animeId], references: [id], onDelete: Cascade)
  manga     Manga?   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId])
  @@unique([userId, animeId])
  @@map("favorites")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  payload   Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ScrapeLog {
  id        String   @id @default(uuid()) @db.Uuid
  source    String?
  endpoint  String?
  slug      String?
  status    String?
  error     String?
  response  Json?
  scrapedAt DateTime @default(now()) @map("scraped_at") @db.Timestamp(0)

  @@map("scrape_logs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String?
  objectType String?  @map("object_type")
  objectId   String?  @map("object_id") @db.Uuid
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("audit_logs")
}

model UserHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  
  animeId   String?  @map("anime_id") @db.Uuid
  episodeId String?  @map("episode_id") @db.Uuid
  
  mangaId   String?  @map("manga_id") @db.Uuid
  chapterId String?  @map("chapter_id") @db.Uuid

  watchedAt     DateTime @default(now()) @map("watched_at") @db.Timestamp(0)
  progress      Int?     @default(0) // Seconds for anime, Page for manga
  totalDuration Int?     @map("total_duration") @default(0) // Total seconds or Total pages

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime     Anime?   @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  manga     Manga?   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@unique([userId, chapterId])
  @@index([userId])
  @@index([watchedAt])
  @@map("user_histories")
}