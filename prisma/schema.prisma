generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

// =======================
// USER & ROLE
// ==========================================

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  name          String?
  photoUrl      String?        @map("photo_url")
  roleId        Int            @default(1) @map("role")
  password      String?
  isActive      Boolean?       @default(true) @map("is_active")
  metadata      Json?          @default("{}")
  createdAt     DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  favorites     Favorite[]
  notifications Notification[]
  role          Role           @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  users     User[]

  // Sesuai error log sebelumnya, tabel di DB bernama 'role'
  @@map("role") 
}

// =======================
// MANGA SECTION
// ==========================================

model Manga {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  slug        String       @unique
  posterUrl   String?      @map("poster_url")
  status      String?
  author      String?
  illustrator String?
  altTitle    String?      @map("alt_title")
  synopsis    String?
  sourceUrl   String?      @map("source_url")
  scrapedAt   DateTime?    @map("scraped_at") @db.Timestamp(0)
  createdAt   DateTime?    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  chapters    Chapter[]
  favorites   Favorite[]
  genres      MangaGenre[]

  @@index([createdAt])
  @@index([updatedAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, name: "manga_title_search_idx")
  @@index([altTitle(ops: raw("gin_trgm_ops"))], type: Gin, name: "manga_alttitle_search_idx")
  @@map("mangas")
}

model Genre {
  id     String       @id @default(uuid()) @db.Uuid
  name   String       @unique
  slug   String       @unique
  mangas MangaGenre[]

  @@map("genres")
}

model MangaGenre {
  mangaId String @map("manga_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  manga   Manga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@id([mangaId, genreId])
  @@map("manga_genres")
}

model Chapter {
  id           String    @id @default(uuid()) @db.Uuid
  mangaId      String?   @map("manga_id") @db.Uuid
  chapterIndex String    @map("chapter_index")
  title        String?
  url          String
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  manga        Manga?    @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([mangaId, chapterIndex])
  @@map("chapters")
}

// =======================
// ANIME SECTION
// ==========================================

model Server {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  url          String        @map("url")
  type         String        @default("anime")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  animeServers AnimeServer[]
  serverGenres ServerGenre[]

  // KEMBALI KE "servers" AGAR DATA TIDAK HILANG
  @@map("servers")
}

model ServerGenre {
  id        String             @id @default(uuid()) @db.Uuid
  serverId  Int                @map("server_id")
  name      String
  slug      String
  url       String?
  createdAt DateTime?          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  server    Server             @relation(fields: [serverId], references: [id], onDelete: Cascade)
  animes    AnimeServerGenre[]

  @@unique([serverId, slug])
  @@map("server_genres")
}

model Anime {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  slug          String        @unique
  altTitle      String?       @map("alt_title")
  posterUrl     String?       @map("poster_url")
  synopsis      String?
  totalEpisodes Int?          @map("total_episodes")
  malId         Int?          @map("mal_id")
  createdAt     DateTime?     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  animeServers  AnimeServer[]
  favorites     Favorite[]

  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, name: "anime_title_search_idx")
  @@map("anime")
}

model AnimeServer {
  id        String             @id @default(uuid()) @db.Uuid
  animeId   String             @map("anime_id") @db.Uuid
  serverId  Int                @map("server_id")
  title     String
  slug      String
  posterUrl String?            @map("poster_url")
  synopsis  String?
  status    String?
  type      String?
  season    String?
  duration  String?
  quality   String?
  rating    String?
  score     String?
  country   String?
  sourceUrl String             @map("source_url")
  scrapedAt DateTime?          @map("scraped_at") @db.Timestamp(0)
  createdAt DateTime?          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  anime     Anime              @relation(fields: [animeId], references: [id], onDelete: Cascade)
  server    Server             @relation(fields: [serverId], references: [id], onDelete: Cascade)
  episodes  Episode[]
  genres    AnimeServerGenre[]

  @@unique([serverId, slug])
  @@map("anime_servers")
}

model AnimeServerGenre {
  animeServerId String      @map("anime_server_id") @db.Uuid
  serverGenreId String      @map("server_genre_id") @db.Uuid
  animeServer   AnimeServer @relation(fields: [animeServerId], references: [id], onDelete: Cascade)
  serverGenre   ServerGenre @relation(fields: [serverGenreId], references: [id], onDelete: Cascade)

  @@id([animeServerId, serverGenreId])
  @@map("anime_server_genres")
}

model Episode {
  id            String          @id @default(uuid()) @db.Uuid
  animeServerId String          @map("anime_server_id") @db.Uuid
  episodeNumber Float           @map("episode_number")
  title         String?
  slug          String?
  url           String
  thumbnailUrl  String?         @map("thumbnail_url")
  releasedAt    DateTime?       @map("released_at") @db.Timestamp(0)
  createdAt     DateTime?       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  animeServer   AnimeServer     @relation(fields: [animeServerId], references: [id], onDelete: Cascade)
  streams       EpisodeStream[]

  @@unique([animeServerId, episodeNumber])
  @@map("episodes")
}

model EpisodeStream {
  id         String    @id @default(uuid()) @db.Uuid
  episodeId  String    @map("episode_id") @db.Uuid
  serverName String?   @map("server_name")
  quality    String
  url        String
  isEmbed    Boolean   @default(false) @map("is_embed")
  priority   Int?      @default(0)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  episode    Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@map("episode_streams")
}

// =======================
// SYSTEM & LOGS
// ==========================================

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  mangaId   String?  @map("manga_id") @db.Uuid
  animeId   String?  @map("anime_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  anime     Anime?   @relation(fields: [animeId], references: [id], onDelete: Cascade)
  manga     Manga?   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId])
  @@unique([userId, animeId])
  @@map("favorites")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  payload   Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ScrapeLog {
  id        String   @id @default(uuid()) @db.Uuid
  source    String?
  endpoint  String?
  slug      String?
  status    String?
  error     String?
  response  Json?
  scrapedAt DateTime @default(now()) @map("scraped_at") @db.Timestamp(0)

  @@map("scrape_logs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String?
  objectType String?  @map("object_type")
  objectId   String?  @map("object_id") @db.Uuid
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("audit_logs")
}